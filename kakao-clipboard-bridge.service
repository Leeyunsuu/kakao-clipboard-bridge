[Unit]
Description=KakaoTalk screenshot clipboard bridge for GNOME and XWayland
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/kakao-clipboard-bridge
Restart=on-failure
RestartSec=3
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
